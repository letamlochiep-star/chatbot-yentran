# Mẫu biến môi trường. KHÔNG điền key thật vào file này và KHÔNG đẩy file .env lên GitHub.
# Trên Vercel: Project → Settings → Environment Variables.

# 5–10 API key Gemini, ngăn cách bằng dấu phẩy
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# (Tùy chọn) Đổi model
# GEMINI_MODEL=gemini-2.5-flash

# (Tùy chọn) Ngân hàng bài toán / hướng dẫn (file đính kèm) dạng văn bản
