# Mẫu biến môi trường hệ thống Cô Trần Thị Hải Yến
# KHÔNG điền key thật vào file này và KHÔNG đẩy file .env lên GitHub.

PORT=3000

# 1 hoặc nhiều API key Gemini, ngăn cách bằng dấu phẩy để hệ thống tự xoay vòng (round-robin)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Chuỗi bí mật ký Token xác thực Quản trị giáo viên
JWT_SECRET=coyen-math-secret-key-2026-production-salt
